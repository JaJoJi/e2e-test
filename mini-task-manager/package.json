{
  "name": "mini-task-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Mini Task Manager - Lab 05 Playwright E2E + Jenkins demo",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
