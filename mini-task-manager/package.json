  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "1.48.0",
    "eslint": "^9.13.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "request": "^2.88.2",
    "supertest": "^7.0.0"
  }
}
