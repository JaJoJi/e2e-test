pipeline {
agent { label 'linux-build' }

options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 15, unit: 'MINUTES')
}

environment {
    COMPOSE_PROJECT_NAME = "mtm-${BUILD_NUMBER}"
    BASE_URL = 'http://web:3000'
}

stages {
    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('Install') {
        steps {
            sh '''
                set -eu

                echo "=== Environment ==="
                echo "Node:    $(node --version 2>/dev/null || echo 'missing')"
                echo "npm:     $(npm --version 2>/dev/null || echo 'missing')"
                echo "Docker:  $(docker --version 2>/dev/null || echo 'missing')"
                echo "Compose: $(docker compose version 2>/dev/null || echo 'missing')"

                echo "=== Workspace ==="
                pwd
                ls -la
            '''
        }
    }

    stage('Start/Test Application') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Project Directory ==="
                    pwd
                    ls -la

                    echo "=== Clean previous Compose resources ==="
                    docker compose down -v --remove-orphans || true

                    echo "=== Start web application ==="
                    docker compose up -d --build --wait web

                    echo "=== Compose status ==="
                    docker compose ps
                '''
            }
        }
    }

    stage('Playwright E2E') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Run Playwright E2E ==="

                    docker compose up \
                        --build \
                        --abort-on-container-exit \
                        --exit-code-from playwright

                    echo "=== Check reports on Jenkins workspace ==="

                    echo "--- e2e/reports ---"
                    find e2e/reports -maxdepth 3 -type f -print 2>/dev/null || true

                    echo "--- e2e/playwright-report ---"
                    find e2e/playwright-report -maxdepth 2 -type f -print 2>/dev/null | head -30 || true

                    echo "--- e2e/test-results ---"
                    find e2e/test-results -maxdepth 3 -type f -print 2>/dev/null | head -30 || true

                    echo "=== Directory listing ==="
                    ls -la e2e
                '''
            }
        }
    }
}

post {
    always {
        dir('mini-task-manager') {
            echo "=== Publish E2E reports ==="

            junit(
                testResults: 'e2e/reports/junit-e2e.xml',
                allowEmptyResults: true
            )

            archiveArtifacts(
                artifacts: 'e2e/playwright-report/**',
                fingerprint: true,
                allowEmptyArchive: true
            )

            archiveArtifacts(
                artifacts: 'e2e/reports/junit-e2e.xml',
                fingerprint: true,
                allowEmptyArchive: true
            )

            archiveArtifacts(
                artifacts: 'e2e/test-results/**',
                fingerprint: true,
                allowEmptyArchive: true
            )

            echo "=== Cleanup Docker Compose ==="

            sh '''
                docker compose down -v --remove-orphans || true
            '''
        }
    }

    success {
        echo "E2E TEST PASSED"
    }

    failure {
        echo "E2E TEST FAILED"
    }
}

}