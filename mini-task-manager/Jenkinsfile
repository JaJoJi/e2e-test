pipeline {
agent {
label 'linux-build'
}

options {
    timestamps()
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 15, unit: 'MINUTES')
}

environment {
    COMPOSE_PROJECT_NAME = "mtm-${BUILD_NUMBER}"
    BASE_URL = 'http://web:3000'
}

stages {

    stage('Start') {
        steps {
            echo '=== Start Mini Task Manager Pipeline ==='
            echo "Branch: ${env.BRANCH_NAME}"
            echo "Build:  ${env.BUILD_NUMBER}"
        }
    }

    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('Secrets Detection — Gitleaks') {
        steps {
        sh '''
        set -eu

                echo "=== Gitleaks Secrets Detection ==="
                echo "Scanning full Git history..."

                CONTAINER="gitleaks-${BUILD_NUMBER}"

                echo "=== Create Gitleaks Container ==="

                docker create \
                    --name "$CONTAINER" \
                    zricethezav/gitleaks:latest \
                    detect \
                    --source=/repo \
                    --redact \
                    --report-format sarif \
                    --report-path=/repo/gitleaks.sarif

                echo "=== Copy Jenkins Workspace into Container ==="

                docker cp . "$CONTAINER:/repo"

                echo "=== Run Gitleaks ==="

                set +e
                docker start -a "$CONTAINER"
                GITLEAKS_EXIT=$?
                set -e

                echo "=== Copy Gitleaks Report ==="

                docker cp \
                    "$CONTAINER:/repo/gitleaks.sarif" \
                    ./gitleaks.sarif

                echo "=== Gitleaks Report ==="
                ls -lh gitleaks.sarif

                echo "=== Cleanup Gitleaks Container ==="
                docker rm "$CONTAINER" >/dev/null

                if [ "$GITLEAKS_EXIT" -ne 0 ]; then
                    echo "Gitleaks detected secrets or failed."
                    exit "$GITLEAKS_EXIT"
                fi

                echo "Gitleaks passed."
            '''
        }

        post {
            always {
                archiveArtifacts(
                    artifacts: 'gitleaks.sarif',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }
        }

        }

    stage('SAST — ESLint Security') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Install dependencies for SAST ==="
                    npm ci --no-audit --no-fund

                    echo "=== ESLint Security Scan ==="

                    npx eslint \
                        --plugin security \
                        --format @microsoft/eslint-formatter-sarif \
                        --output-file eslint-security.sarif \
                        src/

                    echo "=== SARIF Report ==="
                    ls -lh eslint-security.sarif

                    RESULTS=$(node -e "console.log(JSON.parse(require('fs').readFileSync('./eslint-security.sarif','utf8')).runs[0].results.length)")
                    echo "ESLint Security findings: $RESULTS"
                '''
            }
        }

        post {
            always {
                dir('mini-task-manager') {
                    archiveArtifacts(
                        artifacts: 'eslint-security.sarif',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    stage('SAST — Semgrep') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Semgrep SAST (p/owasp-top-ten + p/nodejs) ==="

                    CONTAINER="semgrep-${BUILD_NUMBER}"

                    echo "=== Create Semgrep container ==="
                    docker create \
                        --name "$CONTAINER" \
                        semgrep/semgrep:latest \
                        semgrep \
                            --config p/owasp-top-ten \
                            --config p/nodejs \
                            --sarif \
                            --output /repo/semgrep.sarif \
                            --no-git-ignore \
                            /repo/src

                    echo "=== Copy workspace into container ==="
                    docker cp . "$CONTAINER:/repo"

                    echo "=== Run Semgrep ==="
                    set +e
                    docker start -a "$CONTAINER"
                    SEMGREP_EXIT=$?
                    set -e

                    echo "Semgrep exit code: $SEMGREP_EXIT"

                    echo "=== Copy report out ==="
                    docker cp "$CONTAINER:/repo/semgrep.sarif" ./semgrep.sarif 2>/dev/null || true

                    echo "=== Cleanup ==="
                    docker rm "$CONTAINER" >/dev/null 2>&1 || true

                    if [ "$SEMGREP_EXIT" -ne 0 ]; then
                        echo "Semgrep scan failed (exit $SEMGREP_EXIT)"
                        exit "$SEMGREP_EXIT"
                    fi

                    echo "=== Report ==="
                    ls -lh semgrep.sarif

                    RESULTS=$(node -e "console.log(JSON.parse(require('fs').readFileSync('./semgrep.sarif','utf8')).runs[0].results.length)")
                    echo "Semgrep findings: $RESULTS"

                    echo "=== NOTE: WARNING-level findings do not fail this stage. ==="
                    echo "===       Fail/warn threshold is handled by future policy work. ==="
                '''
            }
        }

        post {
            always {
                dir('mini-task-manager') {
                    archiveArtifacts(
                        artifacts: 'semgrep.sarif',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    stage('SCA — npm audit') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== SCA — npm audit ==="

                    # Run npm audit and ALWAYS capture the JSON, regardless of exit code.
                    # Fail/warn policy is decided in this stage, not by npm's own exit code.
                    set +e
                    npm audit --audit-level=high --json > audit.json 2>audit.stderr
                    AUDIT_EXIT=$?
                    set -e
                    echo "npm audit raw exit code: ${AUDIT_EXIT}"

                    if [ ! -s audit.json ]; then
                        echo "ERROR: audit.json was not produced"
                        cat audit.stderr || true
                        exit 1
                    fi

                    echo "=== Vulnerability Counts ==="
                    node <<'NODE'
const fs = require('fs');

const a = JSON.parse(fs.readFileSync('audit.json', 'utf8'));
const m = (a.metadata && a.metadata.vulnerabilities) || {};

const c = m.critical || 0;
const h = m.high || 0;
const mo = m.moderate || 0;
const l = m.low || 0;
const i = m.info || 0;
const t = m.total || 0;

console.log('critical  = ' + c);
console.log('high      = ' + h);
console.log('moderate  = ' + mo);
console.log('low       = ' + l);
console.log('info      = ' + i);
console.log('total     = ' + t);

if (c > 0) {
  console.error('Blocking: ' + c + ' critical vulnerabilities found');
  process.exit(10);
}

if (h > 0) {
  console.warn('WARNING: ' + h + ' high vulnerabilities found');
}

if (mo > 0) {
  console.warn('INFO: ' + mo + ' moderate vulnerabilities');
}

if (l > 0) {
  console.warn('INFO: ' + l + ' low vulnerabilities');
}

if (i > 0) {
  console.log('INFO: ' + i + ' informational items');
}

console.log('SCA passed: 0 critical vulnerabilities');
NODE
                '''
            }
        }

        post {
            always {
                dir('mini-task-manager') {
                    archiveArtifacts(
                        artifacts: 'audit.json',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    stage('SBOM — Syft + Cosign') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== SBOM — Syft + Cosign ==="

                    SBOM="taskflow-api.cdx.json"
                    SBOM_IMAGE="mtm-sbom-scan:tmp"
                    KEYDIR=".sbom-keys"
                    COSIGN_IMAGE="gcr.io/projectsigstore/cosign:v2.4.1"
                    SYFT_IMAGE="anchore/syft:latest"

                    # Per-build random password; do NOT log it.
                    export COSIGN_PASSWORD
                    COSIGN_PASSWORD="lab06-$(date +%s)-$(head -c 16 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9')"
                    echo "Generated per-build COSIGN_PASSWORD (length=${#COSIGN_PASSWORD}), not logged"

                    # Safety net: wipe keydir on any exit (success, failure, interrupt).
                    cleanup() {
                        rm -rf "$KEYDIR" 2>/dev/null || true
                        unset COSIGN_PASSWORD || true
                    }
                    trap cleanup EXIT

                    # ------------------------------------------------------------------
                    # 1. Build the SBOM scan image (production-only deps, matches
                    #    the same image the Deploy — Staging stage will run later).
                    # ------------------------------------------------------------------
                    echo "=== Build SBOM scan image ==="
                    docker build -t "$SBOM_IMAGE" -f Dockerfile .

                    # ------------------------------------------------------------------
                    # 2. Generate CycloneDX SBOM by scanning the built image.
                    #    We scan the IMAGE rather than the source directory because
                    #    Syft's `dir:` source mode currently produces 0 components
                    #    for npm-only projects; scanning the built image yields the
                    #    real production dependency tree (660 components, 279 npm).
                    # ------------------------------------------------------------------
                    echo "=== Generate SBOM (CycloneDX) ==="
                    SBOM_CTR="sbom-gen-${BUILD_NUMBER:-$$}"
                    docker create --name "$SBOM_CTR" \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        "$SYFT_IMAGE" \
                        scan "docker:$SBOM_IMAGE" -o cyclonedx-json > /dev/null
                    docker start -a "$SBOM_CTR" > "$SBOM" 2>/dev/null
                    SBOM_EXIT=$?
                    docker rm "$SBOM_CTR" > /dev/null 2>&1 || true
                    unset SBOM_CTR
                    if [ "$SBOM_EXIT" -ne 0 ] || [ ! -s "$SBOM" ]; then
                        echo "ERROR: Syft scan failed (exit $SBOM_EXIT)"
                        exit 1
                    fi

                    # Validate SBOM and report component count.
                    node -e "
                        const j = JSON.parse(require('fs').readFileSync('$SBOM','utf8'));
                        const n = (j.components||[]).length;
                        if (j.bomFormat !== 'CycloneDX') {
                            console.error('ERROR: SBOM is not CycloneDX (got: ' + j.bomFormat + ')');
                            process.exit(1);
                        }
                        console.log('SBOM format      : ' + j.bomFormat);
                        console.log('SBOM specVersion : ' + j.specVersion);
                        console.log('SBOM components  : ' + n);
                    "

                    # ------------------------------------------------------------------
                    # 3. Generate ephemeral Cosign keypair.  The private key lives
                    #    only inside the container's overlay; we copy it to a
                    #    workspace-local $KEYDIR for the next steps, then `trap`
                    #    deletes $KEYDIR.  We never archive $KEYDIR.
                    # ------------------------------------------------------------------
                    echo "=== Generate ephemeral Cosign keypair ==="
                    mkdir -p "$KEYDIR"
                    KG_CTR="cosign-keygen-${BUILD_NUMBER:-$$}"
                    docker create --name "$KG_CTR" \
                        -u 0:0 \
                        -e "COSIGN_PASSWORD=$COSIGN_PASSWORD" \
                        "$COSIGN_IMAGE" \
                        generate-key-pair --output-key-prefix /home/nonroot/cosign > /dev/null
                    docker start -a "$KG_CTR" > /dev/null 2>&1
                    docker cp "$KG_CTR:/home/nonroot/cosign.pub" "$KEYDIR/cosign.pub" || { echo "ERROR: cp cosign.pub failed"; exit 1; }
                    docker cp "$KG_CTR:/home/nonroot/cosign.key" "$KEYDIR/cosign.key" || { echo "ERROR: cp cosign.key failed"; exit 1; }
                    docker rm "$KG_CTR" > /dev/null 2>&1 || true
                    unset KG_CTR
                    if [ ! -s "$KEYDIR/cosign.key" ] || [ ! -s "$KEYDIR/cosign.pub" ]; then
                        echo "ERROR: keypair was not produced"
                        exit 1
                    fi
                    # Promote public key out of KEYDIR so it survives trap cleanup.
                    cp "$KEYDIR/cosign.pub" ./cosign.pub

                    # ------------------------------------------------------------------
                    # 4. Sign the SBOM with the ephemeral private key.
                    # ------------------------------------------------------------------
                    echo "=== Sign SBOM ==="
                    SG_CTR="cosign-sign-${BUILD_NUMBER:-$$}"
                    docker create --name "$SG_CTR" \
                        -u 0:0 \
                        -e "COSIGN_PASSWORD=$COSIGN_PASSWORD" \
                        "$COSIGN_IMAGE" \
                        sign-blob \
                            --key /home/nonroot/cosign.key \
                            --output-signature /home/nonroot/${SBOM}.sig \
                            --yes \
                            /home/nonroot/$SBOM > /dev/null
                    docker cp "$SBOM"                "$SG_CTR:/home/nonroot/$SBOM"
                    docker cp "$KEYDIR/cosign.key"   "$SG_CTR:/home/nonroot/cosign.key"
                    docker start -a "$SG_CTR" > /dev/null 2>&1
                    docker cp "$SG_CTR:/home/nonroot/${SBOM}.sig" "./${SBOM}.sig" || { echo "ERROR: cp signature failed"; exit 1; }
                    docker rm "$SG_CTR" > /dev/null 2>&1 || true
                    unset SG_CTR
                    if [ ! -s "${SBOM}.sig" ]; then
                        echo "ERROR: SBOM signature was not produced"
                        exit 1
                    fi

                    # ------------------------------------------------------------------
                    # 5. Verify the signature using ONLY the public key (which is
                    #    archived as a build artifact).  Exit code 0 = verified.
                    # ------------------------------------------------------------------
                    echo "=== Verify SBOM signature ==="
                    VR_CTR="cosign-verify-${BUILD_NUMBER:-$$}"
                    docker create --name "$VR_CTR" \
                        -u 0:0 \
                        "$COSIGN_IMAGE" \
                        verify-blob \
                            --key /home/nonroot/cosign.pub \
                            --signature /home/nonroot/${SBOM}.sig \
                            /home/nonroot/$SBOM > /dev/null
                    docker cp "$SBOM"           "$VR_CTR:/home/nonroot/$SBOM"
                    docker cp "${SBOM}.sig"      "$VR_CTR:/home/nonroot/${SBOM}.sig"
                    docker cp cosign.pub         "$VR_CTR:/home/nonroot/cosign.pub"
                    docker start -a "$VR_CTR"
                    VERIFY_EXIT=$?
                    docker rm "$VR_CTR" > /dev/null 2>&1 || true
                    unset VR_CTR
                    if [ "$VERIFY_EXIT" -ne 0 ]; then
                        echo "ERROR: Cosign signature verification FAILED (exit $VERIFY_EXIT)"
                        exit 1
                    fi
                    echo "=== SBOM + signature VERIFIED ==="

                    echo "=== Final SBOM component count ==="
                    node -e "console.log((JSON.parse(require('fs').readFileSync('$SBOM','utf8')).components||[]).length + ' components')"
                '''
            }
        }

        post {
            always {
                dir('mini-task-manager') {
                    // Safety net: ensure the ephemeral private key dir is gone
                    // even if the stage skipped cleanup (e.g. JVM abort).
                    sh 'rm -rf .sbom-keys || true'

                    // Archive ONLY the public material.  Never archive cosign.key.
                    archiveArtifacts(
                        artifacts: 'taskflow-api.cdx.json,taskflow-api.cdx.json.sig,cosign.pub',
                        fingerprint: true,
                        allowEmptyArchive: false
                    )
                }
            }
        }
    }

    stage('Policy Gate — OPA') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Policy Gate — OPA ==="

                    AUDIT="audit.json"
                    POLICY_DIR="policy"
                    POLICY_FILE="policy/security.rego"
                    OPA_IMAGE="openpolicyagent/opa:latest"

                    # 1. Preconditions: both the SCA output and the Rego policy must exist.
                    if [ ! -s "$AUDIT" ]; then
                        echo "ERROR: $AUDIT not found. SCA stage must run first."
                        exit 1
                    fi
                    if [ ! -s "$POLICY_FILE" ]; then
                        echo "ERROR: $POLICY_FILE not found."
                        exit 1
                    fi

                    # 2. Echo vulnerability summary so the log shows what OPA is judging.
                    node -e "
                        const fs = require('fs');
                        const a = JSON.parse(fs.readFileSync('$AUDIT','utf8'));
                        const v = (a.metadata && a.metadata.vulnerabilities) || {};
                        console.log('vulnerability counts (from $AUDIT):');
                        console.log('  critical = ' + (v.critical || 0));
                        console.log('  high     = ' + (v.high     || 0));
                        console.log('  moderate = ' + (v.moderate || 0));
                        console.log('  low      = ' + (v.low      || 0));
                        console.log('  info     = ' + (v.info     || 0));
                    "

                    # 3. Run OPA on the audit.json input via docker create/cp/start/cp/rm.
                    #    Two queries: `allow` (boolean decision) and `deny` (reason msgs).
                    echo "=== OPA eval (data.security.allow) ==="
                    ALLOW_CTR="opa-allow-${BUILD_NUMBER:-$$}"
                    docker create --name "$ALLOW_CTR" \
                        "$OPA_IMAGE" \
                        eval -d /policy -i /audit.json "data.security.allow" > /dev/null
                    docker cp "$AUDIT"     "$ALLOW_CTR:/audit.json"
                    docker cp "$POLICY_DIR" "$ALLOW_CTR:/policy"
                    docker start -a "$ALLOW_CTR" > /tmp/opa-allow.json 2>&1
                    docker rm "$ALLOW_CTR" > /dev/null 2>&1 || true
                    unset ALLOW_CTR

                    echo "=== OPA eval (data.security.deny) ==="
                    DENY_CTR="opa-deny-${BUILD_NUMBER:-$$}"
                    docker create --name "$DENY_CTR" \
                        "$OPA_IMAGE" \
                        eval -d /policy -i /audit.json "data.security.deny" > /dev/null
                    docker cp "$AUDIT"     "$DENY_CTR:/audit.json"
                    docker cp "$POLICY_DIR" "$DENY_CTR:/policy"
                    docker start -a "$DENY_CTR" > /tmp/opa-deny.json 2>&1
                    docker rm "$DENY_CTR" > /dev/null 2>&1 || true
                    unset DENY_CTR

                    # 4. Parse the OPA JSON output and decide.
                    ALLOW=$(node -e "
                        const j = JSON.parse(require('fs').readFileSync('/tmp/opa-allow.json','utf8'));
                        process.stdout.write(String(j.result[0].expressions[0].value));
                    ")
                    DENY_RAW=$(node -e "
                        const j = JSON.parse(require('fs').readFileSync('/tmp/opa-deny.json','utf8'));
                        const v = j.result[0].expressions[0].value;
                        process.stdout.write(JSON.stringify(v));
                    ")

                    echo ""
                    echo "=== OPA Policy Decision ==="
                    if [ "$ALLOW" = "true" ]; then
                        echo "OPA Policy Decision: ALLOW"
                        echo "Policy Gate passed: 0 critical vulnerabilities"
                    else
                        echo "OPA Policy Decision: DENY"
                        echo "Reason(s):"
                        # Print each deny message on its own line.
                        echo "$DENY_RAW" | node -e "
                            let raw = '';
                            process.stdin.on('data', d => raw += d);
                            process.stdin.on('end', () => {
                                const v = JSON.parse(raw);
                                if (Array.isArray(v)) {
                                    for (const m of v) console.log('  - ' + m);
                                } else {
                                    console.log('  - DENY');
                                }
                            });
                        "
                        echo ""
                        echo "Policy Gate FAILED."
                        exit 1
                    fi
                '''
            }
        }
    }

    stage('Build Image') {
        steps {
            dir('mini-task-manager') {
                script {
                    env.SHORT_SHA = env.GIT_COMMIT.take(7)
                }
                sh '''
                    set -eu

                    echo "=== Build Image ==="

                    IMAGE="taskflow-api:${SHORT_SHA}"
                    REGISTRY_IMAGE="localhost:5000/taskflow-api:${SHORT_SHA}"

                    echo "Image:          ${IMAGE}"
                    echo "Registry image: ${REGISTRY_IMAGE}"

                    # Tag must be the 7-character Git short SHA.
                    echo "${SHORT_SHA}" | grep -Eq '^[0-9a-f]{7}$'

                    # 1. Ensure the local registry (registry:2) is running.
                    #    Idempotent: reuse the existing container when present.
                    if [ -z "$(docker ps -q -f 'name=^local-registry$')" ]; then
                        if [ -n "$(docker ps -aq -f 'name=^local-registry$')" ]; then
                            echo "Starting existing local-registry container..."
                            docker start local-registry
                        else
                            echo "Creating local registry (registry:2)..."
                            docker run -d --name local-registry --restart unless-stopped -p 5000:5000 registry:2
                        fi
                    else
                        echo "Local registry already running."
                    fi

                    # 2. Build the image from mini-task-manager/Dockerfile.
                    #    Any failure here fails the pipeline (no '|| true').
                    docker build -t "${IMAGE}" -f Dockerfile .

                    # 3. Tag for the local registry and push.
                    docker tag "${IMAGE}" "${REGISTRY_IMAGE}"
                    docker push "${REGISTRY_IMAGE}"

                    # 4. Verify the push: drop the local registry-tagged copy
                    #    and pull it back. Pull succeeds only if the push landed.
                    docker rmi "${REGISTRY_IMAGE}"
                    docker pull "${REGISTRY_IMAGE}"

                    echo "=== Build + Push verified ==="
                    docker images "localhost:5000/taskflow-api" --format '{{.Repository}}:{{.Tag}}'
                '''
            }
        }
    }

    stage('Container Scan — Trivy') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Container Scan — Trivy ==="

                    IMAGE="localhost:5000/taskflow-api:${SHORT_SHA}"
                    TRIVY_IMAGE="aquasec/trivy:0.74.0"

                    echo "Scan image: ${IMAGE}"
                    echo "Trivy:      ${TRIVY_IMAGE}"

                    # Same 7-char SHA as the Build Image stage.
                    echo "${SHORT_SHA}" | grep -Eq '^[0-9a-f]{7}$'

                    # 1. Human-readable table scan for the console log.
                    #    Exit code 0: informational only, never blocks.
                    echo "=== Trivy table scan (HIGH,CRITICAL) ==="
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v trivy-cache:/root/.cache \
                        "${TRIVY_IMAGE}" \
                        image --scanners vuln --severity HIGH,CRITICAL \
                            --no-progress --exit-code 0 "${IMAGE}" > trivy-table.log 2>&1
                    cat trivy-table.log
                    if grep -E '^Total:' trivy-table.log; then
                        echo "(table summary above)"
                    else
                        echo "(no Total summary line in table output)"
                    fi

                    # 2. SARIF scan that blocks on HIGH/CRITICAL (exit 1).
                    #    The report is copied out of the container BEFORE the
                    #    stage exits, so the post-always archive always has the
                    #    file even when the scan fails. Errors are never masked.
                    echo "=== Trivy SARIF scan (HIGH,CRITICAL, exit-code 1) ==="
                    SARIF_CTR="trivy-sarif-${BUILD_NUMBER:-$$}"
                    docker create --name "${SARIF_CTR}" \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v trivy-cache:/root/.cache \
                        "${TRIVY_IMAGE}" \
                        image --scanners vuln --severity HIGH,CRITICAL \
                            --no-progress --format sarif -o /tmp/trivy.sarif \
                            --exit-code 1 "${IMAGE}" > /dev/null
                    set +e
                    docker start -a "${SARIF_CTR}" > trivy-scan.log 2>&1
                    TRIVY_EXIT=$?
                    set -e
                    cat trivy-scan.log
                    docker cp "${SARIF_CTR}:/tmp/trivy.sarif" ./trivy.sarif
                    docker rm "${SARIF_CTR}" > /dev/null

                    # 3. Summarize HIGH/CRITICAL counts from the SARIF report.
                    echo "=== Trivy summary (from trivy.sarif) ==="
                    node <<'NODE'
const fs = require('fs');
const sarif = JSON.parse(fs.readFileSync('trivy.sarif', 'utf8'));
const run = (sarif.runs && sarif.runs[0]) || {};
const rules = ((run.tool && run.tool.driver && run.tool.driver.rules) || []);
const results = run.results || [];
const sevOf = (ruleId) => {
    const r = rules.find(x => x.id === ruleId) || {};
    const p = r.properties || {};
    return (p.severity || p['security-severity'] || '').toUpperCase();
};
let high = 0, crit = 0, other = 0;
for (const res of results) {
    const s = sevOf(res.ruleId);
    if (s === 'CRITICAL') crit++;
    else if (s === 'HIGH') high++;
    else other++;
}
console.log('HIGH     = ' + high);
console.log('CRITICAL = ' + crit);
console.log('other    = ' + other);
console.log('total    = ' + results.length);
NODE

                    # 4. Block the pipeline when Trivy found HIGH/CRITICAL.
                    echo "Trivy exit code: ${TRIVY_EXIT}"
                    if [ "${TRIVY_EXIT}" -ne 0 ]; then
                        echo "Blocking: Trivy found HIGH/CRITICAL vulnerabilities."
                        exit "${TRIVY_EXIT}"
                    fi
                    echo "Trivy passed: no HIGH/CRITICAL vulnerabilities."
                '''
            }
        }

        post {
            always {
                dir('mini-task-manager') {
                    archiveArtifacts(
                        artifacts: 'trivy.sarif',
                        fingerprint: true,
                        allowEmptyArchive: false
                    )
                }
            }
        }
    }

    stage('Install') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Environment ==="
                    node --version
                    npm --version
                    docker --version
                    docker compose version

                    echo "=== Install Dependencies ==="
                    npm ci
                '''
            }
        }
    }

    stage('Lint') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== ESLint ==="
                    npm run lint
                '''
            }
        }
    }

    stage('Unit Test') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Unit Test + Coverage ==="

                    npm test -- --coverage

                    echo "=== Unit Test Reports ==="
                    ls -lh test-results/
                    ls -lh coverage/
                '''
            }
        }

        post {
            always {
                dir('mini-task-manager') {
                    junit(
                        testResults: 'test-results/junit-unit.xml',
                        allowEmptyResults: true
                    )

                    recordCoverage(
                        tools: [[
                            parser: 'COBERTURA',
                            pattern: 'coverage/cobertura-coverage.xml'
                        ]],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )

                    archiveArtifacts(
                        artifacts: 'coverage/**',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    stage('SonarQube Analysis') {
        steps {
            dir('mini-task-manager') {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner
                        """
                    }
                }
            }
        }
    }

    stage('Quality Gate') {
        steps {
            timeout(time: 5, unit: 'MINUTES') {
                waitForQualityGate abortPipeline: true
            }
        }
    }

    stage('Deploy — Staging') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Deploy — Staging ==="

                    docker compose down -v --remove-orphans || true

                    docker compose up -d --build --wait web

                    echo "=== Staging Status ==="
                    docker compose ps
                '''
            }
        }
    }

    stage('Playwright E2E') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Run Playwright E2E ==="

                    docker compose up \
                        --build \
                        --abort-on-container-exit \
                        --exit-code-from playwright

                    echo "=== Copy reports from Playwright container ==="

                    mkdir -p e2e/reports
                    mkdir -p e2e/playwright-report
                    mkdir -p e2e/test-results

                    docker cp mtm-playwright:/app/e2e/reports/. \
                        e2e/reports/

                    docker cp mtm-playwright:/app/e2e/playwright-report/. \
                        e2e/playwright-report/

                    docker cp mtm-playwright:/app/e2e/test-results/. \
                        e2e/test-results/

                    echo "=== Verify Reports ==="

                    test -f e2e/reports/junit-e2e.xml
                    test -f e2e/playwright-report/index.html

                    ls -lh e2e/reports/
                    ls -lh e2e/playwright-report/ | head
                '''
            }
        }

        post {
            always {
                dir('mini-task-manager') {
                    junit(
                        testResults: 'e2e/reports/junit-e2e.xml',
                        allowEmptyResults: true
                    )

                    archiveArtifacts(
                        artifacts: 'e2e/playwright-report/**',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    archiveArtifacts(
                        artifacts: 'e2e/reports/junit-e2e.xml',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    archiveArtifacts(
                        artifacts: 'e2e/test-results/**',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    stage('Deploy — Production') {
        when {
            branch 'main'
        }

        steps {
            input message: 'Deploy to production?'

            echo '=== Deploy — Production ==='
            echo 'Production deployment simulated for Lab 05.'
        }
    }

    stage('End') {
        steps {
            echo '=== End Mini Task Manager Pipeline ==='
        }
    }
}

post {
    always {
        dir('mini-task-manager') {
            echo '=== Cleanup Docker Compose ==='

            sh '''
                docker compose down -v --remove-orphans || true
            '''
        }
    }

    success {
        echo 'PIPELINE PASSED'
    }

    failure {
        echo 'PIPELINE FAILED'
    }
}

}
