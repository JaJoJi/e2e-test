pipeline {
  agent { label 'linux-build' }

  options {
    timestamps()
    disableConcurrentBuilds()
    ansiColor('xterm')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    COMPOSE_PROJECT_NAME = "mtm-${BUILD_NUMBER}"
    BASE_URL             = 'http://web:3000'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install') {
      steps {
        sh '''
          set -eu
          echo "Node:    $(node --version 2>/dev/null || echo 'missing')"
          echo "npm:     $(npm --version 2>/dev/null || echo 'missing')"
          echo "Docker:  $(docker --version 2>/dev/null || echo 'missing')"
          echo "Compose: $(docker compose version 2>/dev/null || echo 'missing')"
        '''
      }
    }

    stage('Start/Test Application') {
      steps {
        sh '''
          set -eu
          docker compose down -v --remove-orphans || true
          docker compose up -d --build --wait web
          docker compose ps
        '''
      }
    }

    stage('Playwright E2E') {
      steps {
        sh '''
          set -eu
          docker compose up --build --abort-on-container-exit --exit-code-from playwright
        '''
      }
    }
  }

  post {
    always {
      sh 'docker compose down -v --remove-orphans || true'
    }
    success {
      junit testResults: 'e2e/reports/junit-e2e.xml', allowEmptyResults: false
      archiveArtifacts artifacts: 'e2e/playwright-report/**,e2e/reports/junit-e2e.xml,e2e/test-results/**',
                         fingerprint: true,
                         allowEmptyArchive: false
    }
    failure {
      junit testResults: 'e2e/reports/junit-e2e.xml', allowEmptyResults: true
      archiveArtifacts artifacts: 'e2e/playwright-report/**,e2e/reports/junit-e2e.xml,e2e/test-results/**',
                         fingerprint: true,
                         allowEmptyArchive: true
    }
  }
}
