pipeline {
agent {
label 'linux-build'
}

options {
    timestamps()
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 15, unit: 'MINUTES')
}

environment {
    COMPOSE_PROJECT_NAME = "mtm-${BUILD_NUMBER}"
    BASE_URL = 'http://web:3000'
}

stages {

    stage('Start') {
        steps {
            echo '=== Start Mini Task Manager Pipeline ==='
            echo "Branch: ${env.BRANCH_NAME}"
            echo "Build:  ${env.BUILD_NUMBER}"
        }
    }

    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('Install') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Environment ==="
                    node --version
                    npm --version
                    docker --version
                    docker compose version

                    echo "=== Install Dependencies ==="
                    npm ci
                '''
            }
        }
    }

    stage('Lint') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== ESLint ==="
                    npm run lint
                '''
            }
        }
    }

    stage('Unit Test') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Unit Test + Coverage ==="

                    npm test -- --coverage

                    echo "=== Unit Test Reports ==="
                    ls -lh test-results/
                    ls -lh coverage/
                '''
            }
        }

        post {
            always {
                dir('mini-task-manager') {
                    junit(
                        testResults: 'test-results/junit-unit.xml',
                        allowEmptyResults: true
                    )

                    recordCoverage(
                        tools: [[
                            parser: 'COBERTURA',
                            pattern: 'coverage/cobertura-coverage.xml'
                        ]],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )

                    archiveArtifacts(
                        artifacts: 'coverage/**',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    stage('SonarQube Analysis') {
        steps {
            dir('mini-task-manager') {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner
                        """
                    }
                }
            }
        }
    }

    stage('Quality Gate') {
        steps {
            timeout(time: 5, unit: 'MINUTES') {
                waitForQualityGate abortPipeline: true
            }
        }
    }

    stage('Deploy — Staging') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Deploy — Staging ==="

                    docker compose down -v --remove-orphans || true

                    docker compose up -d --build --wait web

                    echo "=== Staging Status ==="
                    docker compose ps
                '''
            }
        }
    }

    stage('Playwright E2E') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Run Playwright E2E ==="

                    docker compose up \
                        --build \
                        --abort-on-container-exit \
                        --exit-code-from playwright

                    echo "=== Copy reports from Playwright container ==="

                    mkdir -p e2e/reports
                    mkdir -p e2e/playwright-report
                    mkdir -p e2e/test-results

                    docker cp mtm-playwright:/app/e2e/reports/. \
                        e2e/reports/

                    docker cp mtm-playwright:/app/e2e/playwright-report/. \
                        e2e/playwright-report/

                    docker cp mtm-playwright:/app/e2e/test-results/. \
                        e2e/test-results/

                    echo "=== Verify Reports ==="

                    test -f e2e/reports/junit-e2e.xml
                    test -f e2e/playwright-report/index.html

                    ls -lh e2e/reports/
                    ls -lh e2e/playwright-report/ | head
                '''
            }
        }

        post {
            always {
                dir('mini-task-manager') {
                    junit(
                        testResults: 'e2e/reports/junit-e2e.xml',
                        allowEmptyResults: true
                    )

                    archiveArtifacts(
                        artifacts: 'e2e/playwright-report/**',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    archiveArtifacts(
                        artifacts: 'e2e/reports/junit-e2e.xml',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    archiveArtifacts(
                        artifacts: 'e2e/test-results/**',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    stage('Deploy — Production') {
        when {
            branch 'main'
        }

        steps {
            input message: 'Deploy to production?'

            echo '=== Deploy — Production ==='
            echo 'Production deployment simulated for Lab 05.'
        }
    }

    stage('End') {
        steps {
            echo '=== End Mini Task Manager Pipeline ==='
        }
    }
}

post {
    always {
        dir('mini-task-manager') {
            echo '=== Cleanup Docker Compose ==='

            sh '''
                docker compose down -v --remove-orphans || true
            '''
        }
    }

    success {
        echo 'PIPELINE PASSED'
    }

    failure {
        echo 'PIPELINE FAILED'
    }
}

}
