pipeline {
agent { label 'linux-build' }

options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 15, unit: 'MINUTES')
}

environment {
    COMPOSE_PROJECT_NAME = "mtm-${BUILD_NUMBER}"
    BASE_URL = 'http://web:3000'
}

stages {
    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('Install') {
        steps {
            sh '''
                set -eu

                echo "=== Environment ==="
                echo "Node:    $(node --version 2>/dev/null || echo 'missing')"
                echo "npm:     $(npm --version 2>/dev/null || echo 'missing')"
                echo "Docker:  $(docker --version 2>/dev/null || echo 'missing')"
                echo "Compose: $(docker compose version 2>/dev/null || echo 'missing')"

                echo "=== Workspace ==="
                pwd
                ls -la
            '''
        }
    }

    stage('Start/Test Application') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Project Directory ==="
                    pwd
                    ls -la

                    echo "=== Clean previous Compose resources ==="
                    docker compose down -v --remove-orphans || true

                    echo "=== Start web application ==="
                    docker compose up -d --build --wait web

                    echo "=== Compose status ==="
                    docker compose ps
                '''
            }
        }
    }

    stage('Playwright E2E') {
        steps {
            dir('mini-task-manager') {
                sh '''
                    set -eu

                    echo "=== Run Playwright E2E ==="

                    docker compose up \
                        --build \
                        --abort-on-container-exit \
                        --exit-code-from playwright

                    echo "=== Copy reports from Playwright container ==="

                    mkdir -p e2e/reports
                    mkdir -p e2e/playwright-report
                    mkdir -p e2e/test-results

                    docker cp mtm-playwright:/app/e2e/reports/. \
                        e2e/reports/

                    docker cp mtm-playwright:/app/e2e/playwright-report/. \
                        e2e/playwright-report/

                    docker cp mtm-playwright:/app/e2e/test-results/. \
                        e2e/test-results/

                    echo "=== Verify JUnit report ==="
                    ls -lh e2e/reports/
                    test -f e2e/reports/junit-e2e.xml

                    echo "=== Verify Playwright HTML report ==="
                    ls -lh e2e/playwright-report/ | head
                    test -f e2e/playwright-report/index.html

                    echo "=== Verify test results ==="
                    find e2e/test-results -maxdepth 3 -type f -print | head -30

                    echo "=== Reports successfully copied to Jenkins workspace ==="
                '''
            }
        }
    }
}

post {
    always {
        dir('mini-task-manager') {
            echo "=== Publish E2E reports ==="

            junit(
                testResults: 'e2e/reports/junit-e2e.xml',
                allowEmptyResults: false
            )

            archiveArtifacts(
                artifacts: 'e2e/playwright-report/**',
                fingerprint: true,
                allowEmptyArchive: false
            )

            archiveArtifacts(
                artifacts: 'e2e/reports/junit-e2e.xml',
                fingerprint: true,
                allowEmptyArchive: false
            )

            archiveArtifacts(
                artifacts: 'e2e/test-results/**',
                fingerprint: true,
                allowEmptyArchive: false
            )

            echo "=== Cleanup Docker Compose ==="

            sh '''
                docker compose down -v --remove-orphans || true
            '''
        }
    }

    success {
        echo "E2E TEST PASSED"
    }

    failure {
        echo "E2E TEST FAILED"
    }
}

}
